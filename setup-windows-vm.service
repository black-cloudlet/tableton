[Unit]
Description=Import Embedded Windows VM
After=libvirtd.service virtqemud.socket
Wants=libvirtd.service virtqemud.socket
ConditionPathExists=/usr/share/tableton/windows/windows10.qcow2

[Service]
Type=oneshot
ExecStart=/usr/libexec/tableton/setup-windows-vm.sh
RemainAfterExit=yes

[Install]
WantedBy=graphical.target
